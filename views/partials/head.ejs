<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>AnimeNexo - أكبر موقع عربي لمشاهدة الانمي المترجم بسرفرات متعددة واداء ممتاز</title>
  <meta name="google-site-verification" content="3q-ARU1DSAEIKGhB4Y3pq3rE59VNnmRwcGAM0mY4PVE" />
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&family=Outfit:wght@400;600;800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    /* ──────────────────── RESET & BASE (RTL) ──────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:        #0d0f1a;
      --surface:   #161827;
      --card:      #1c1f32;
      --border:    rgba(255,255,255,0.07);
      --accent:    #7c5cfc;
      --accent2:   #c05cfc;
      --text:      #e8eaf6;
      --muted:     #8890b0;
      --radius:    14px;
      --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    body {
      font-family: 'Tajawal', 'Outfit', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
      text-align: right;
    }
    a { text-decoration: none; color: inherit; }
    img { display: block; max-width: 100%; }

    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 10px; }

    /* ──────────────────── NAVBAR ──────────────────── */
    .navbar {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 32px; height: 80px;
      background: rgba(13,15,26,0.85);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
    }
    
    /* Hamburger Menu */
    .hamburger {
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      gap: 5px;
      width: 42px;
      height: 42px;
      border-radius: 20%;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      transition: all var(--transition);
    }
    .hamburger:hover {
      border-color: var(--accent);
      background: rgba(124, 92, 252, 0.12);
    }
    
    .hamburger span {
      width: 18px;
      height: 2px;
      background: var(--text);
      border-radius: 2px;
      transition: 0.3s ease;
    }
    
    .hamburger.active span:nth-child(1) {
      transform: rotate(45deg) translate(10px, 10px);
    }
    
    .hamburger.active span:nth-child(2) {
      opacity: 0;
    }
    
    .hamburger.active span:nth-child(3) {
      transform: rotate(-45deg) translate(7px, -7px);
    }
    
    /* Mobile Sidebar */
    .mobile-menu {
      position: fixed;
      right: -100%;
      top: 40px;
      width: 85%;
      max-width: 320px;
      height: calc(100vh - 70px);
      background: linear-gradient(180deg, var(--surface) 0%, var(--card) 100%);
      border-left: 2px solid var(--accent);
      border-radius: 0 10px 10px 0;
      transition: right 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 99;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      padding: 0;
      box-shadow: -5px 0 30px rgba(0, 0, 0, 0.5);
    }
    
    .mobile-menu.active {
      right: 0;
      box-shadow: -8px 0 40px rgba(124, 92, 252, 0.3);
    }
    
    .mobile-menu .search-bar {
      width: calc(100% - 20px);
      margin: 15px 10px;
      font-size: 0.9rem;
    }
    
    .mobile-menu .nav-links {
      display: flex;
      flex-direction: column;
      gap: 0;
      margin: 10px 0 0 0;
      width: 100%;
      list-style: none;
      padding: 0;
    }
    
    .mobile-menu .nav-links li {
      width: 100%;
      margin: 0;
      padding: 0;
    }
    
    .mobile-menu .nav-links li a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 15px 16px;
      border-radius: 0;
      background: transparent;
      border: none;
      border-left: 3px solid transparent;
      width: 100%;
      font-size: 1rem;
      color: var(--text);
      text-align: right;
      transition: all 0.2s ease;
      font-weight: 600;
    }
    
    .mobile-menu .nav-links li a:hover,
    .mobile-menu .nav-links li a:active {
      background: rgba(124, 92, 252, 0.15);
      border-left-color: var(--accent);
      padding-right: 8px;
    }
    
    .mobile-menu .nav-links li a svg {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
    }

    .mobile-menu-header {
      display: none;
    }

    .mobile-server-toggle {
      background: var(--surface);
      border: 1px solid var(--border);
      width: 38px;
      height: 38px;
      border-radius: 50%;
      color: var(--text);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all var(--transition);
      flex-shrink: 0;
    }
    .mobile-server-toggle:hover {
      border-color: var(--accent);
      background: rgba(124, 92, 252, 0.12);
    }

    .mobile-search-toggle {
      display: none;
      width: 42px;
      height: 42px;
      border-radius: 20%;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .mobile-actions {
      display: none;
      align-items: center;
      gap: 5px;
    }

    .mobile-search-panel {
      display: none;
      position: fixed;
      top: 76px;
      left: 12px;
      right: 12px;
      z-index: 120;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 10px;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.35);
    }

    .mobile-search-panel.active {
      display: block;
    }

    .mobile-search-panel .search-bar {
      width: 100%;
      margin: 0;
    }
    
    .nav-right, .nav-left { display: flex; align-items: center; gap: 20px; }
    
    .logo {
      font-size: 1.8rem; font-weight: 800; font-family: 'Outfit', sans-serif;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .nav-links {
      list-style: none; display: flex; gap: 24px; margin-right: 25px;
    }
    .nav-links li a {
      font-weight: 700; color: var(--muted); font-size: 0.9rem;
      transition: color var(--transition), transform var(--transition);
      display: flex; align-items: center; gap: 8px;
    }
    .nav-links li a:hover { color: var(--text); transform: translateY(-2px); }
    .nav-links li a svg { opacity: 0.7; }
    .nav-links li a:hover svg { opacity: 1; color: var(--accent); }
    
    .search-bar {
      display: flex; align-items: center; gap: 8px;
      background: var(--card); border: 1px solid var(--border);
      border-radius: 50px; padding: 6px 16px; width: 320px;
      transition: border-color var(--transition);
    }
    .search-bar:focus-within { border-color: var(--accent); }
    .search-bar input {
      background: none; border: none; outline: none;
      color: var(--text); font-family: inherit; width: 100%; font-size: 0.9rem;
    }
    .search-bar input::placeholder { color: var(--muted); }
    .search-bar button {
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      border: none; border-radius: 50px; padding: 8px 20px; color: #fff;
      font-family: inherit; font-weight: 700; cursor: pointer; font-size: 0.85rem;
    }

    .nav-btn {
      background: var(--surface); border: 1px solid var(--border);
      padding: 8px 18px; border-radius: 50px; color: var(--text);
      font-family: inherit; font-weight: 700; cursor: pointer;
      transition: all var(--transition);
      display: flex; align-items: center; gap: 8px;
    }
    .nav-btn:hover { border-color: var(--accent); background: rgba(124, 92, 252, 0.1); }
    .icon-btn { padding: 10px; border-radius: 50%; display: flex; align-items: center; justify-content: center; position: relative; }
    .notif-dot { position: absolute; top: 8px; right: 8px; width: 8px; height: 8px; background: #ff4757; border-radius: 50%; border: 2px solid var(--surface); }

    .btn-srv{
        padding:10px; border-radius: 12px; background: var(--surface); 
        border: 1px solid var(--border);
        color: var(--text);
        font-family: inherit;
        font-weight: 700;
        cursor: pointer;
        transition: all var(--transition);
    }
    .btn-srv:hover {
        border-color: var(--accent);
        background: rgba(124, 92, 252, 0.1);
    }
    .btn-srv.active {
        border-color: var(--accent);
        background: rgba(124, 92, 252, 0.1);
    }
    /* ──────────────────── MODAL ──────────────────── */
    .modal {
      position: fixed; inset: 0; z-index: 1000;
      background: rgba(0,0,0,0.8); display: none;
      align-items: center; justify-content: center;
      backdrop-filter: blur(8px);
    }
    .modal-content {
      background: var(--card); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 35px; width: 350px;
      text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.5);
      animation: modalFade 0.3s ease;
    }
    @keyframes modalFade { from { opacity:0; transform: scale(0.9); } to { opacity:1; transform: scale(1); } }
    .modal h3 { margin-bottom: 25px; font-size: 1.5rem; font-weight: 800; }
    .server-list-modal { display: flex; flex-direction: column; gap: 12px; margin-bottom: 25px; }
    .close-modal { background: transparent; border: 1px solid var(--muted); color: var(--muted); width: 100%; padding: 10px; border-radius: 12px; cursor: pointer; font-family: inherit; font-weight: 600; }
    
    /* ──────────────────── PAGE CONTENT ──────────────────── */
    .container { max-width: 1300px; margin: 0 auto; padding: 0 24px 80px; }
    .section-title { font-size: 1.5rem; font-weight: 800; margin-bottom: 25px; display: flex; align-items: center; gap: 12px; }
    .section-title::before { content: ''; display: block; width: 5px; height: 25px; border-radius: 5px; background: linear-gradient(to bottom, var(--accent), var(--accent2)); }

    .list-header { 
        display: flex; align-items: center; justify-content: space-between;
        margin-top: 20px; 
        margin-bottom: 30px; background: var(--card); padding: 15px 25px; 
        border-radius: var(--radius); border: 1px solid var(--border);
    }
    .dropdown-sever-selector{
        position: relative;
        display: inline-block;
        width: max-content;
    }
    .dropbtn{
        padding: 8px 20px; border-radius: 50px; background: var(--surface); 
        border: 1px solid var(--border); font-weight: 700; font-size: 0.85rem; 
        transition: 0.2s; cursor: pointer;
        color: var(--text);
        font-family: inherit;
        scale: 1.2;
    }
    .dropdown-content {
      display: none; 
      position: absolute;
      top: 100%; right: 0;
      background-color: var(--card);
      min-width: 250px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      z-index: 1000;
      border-radius: 12px;
      border: 1px solid var(--border);
      margin-top: 10px;
      overflow: hidden;
    }

   .dropdown-content a {
     color: var(--text);
     padding: 12px 16px;
     margin: 5px;
     border-radius: 12px;
     text-decoration: none;
     display: block;
     font-size: 18px;
     font-weight: 700;
    }
    .dropdown-content a:hover {
        background-color: var(--accent);
        color: #fff;
    }
    .show{
        display: block;
    }
    /* ──────────────────── PAGINATION ──────────────────── */
    .pagination { display: flex;gap: 10px; margin-top: 40px; }
    .pg-btn { background: var(--card); border: 1px solid var(--border); padding: 10px 25px; border-radius: 10px; font-weight: 700; transition: 0.2s; }
    .pg-btn:hover { border-color: var(--accent); background: rgba(124,92,252,0.1); }


    /* ──────────────────── HERO SLIDER (REFINED) ──────────────────── */
    .hero { 
        position: relative; overflow: hidden; height: 500px; 
        margin-top: 20px; 
        margin-bottom: 40px; background: var(--surface); 
        border-radius: var(--radius); 
        border: 1px solid var(--border);
    }
    .slide { 
        position: absolute; inset: 0; display: flex; 
        align-items: flex-end; justify-content: flex-start;
        opacity: 0; transition: 0.8s ease; pointer-events: none; 
    }
    .slide.active { opacity: 1; pointer-events: auto; }
    .slide-bg { 
        position: absolute; inset: 0; 
        background-size: cover; background-position: center; 
        filter: brightness(0.7);
    }
    .slide-overlay { 
        position: absolute; inset: 0; 
        background: linear-gradient(to top, rgba(13,15,26,1) 0%, rgba(13,15,26,0.3) 50%, transparent 100%); 
    }
    .slide-info { 
        position: relative; z-index: 2; width: 100%;
        padding: 40px 60px 60px;
        transform: translateY(20px);
        transition: 0.6s ease-out; opacity: 0;
    }
    .slide.active .slide-info { transform: translateY(0); opacity: 1; }
    
    .slide-badge { 
        background: var(--accent); color: #fff;
        border-radius: 6px; padding: 4px 12px; font-size: 0.7rem; 
        font-weight: 800; margin-bottom: 15px; display: inline-block; 
    }
    .slide-title { 
        font-size: 2.2rem; font-weight: 800; line-height: 1.2;
        margin-bottom: 10px; color: #fff;
    }
    .slide-ep { color: var(--accent); font-weight: 700; font-size: 1rem; margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
    .slider-dots { 
        position: absolute; bottom: 25px; left: 60px;
        display: flex; gap: 8px; z-index: 5; 
    }
    .dot { 
        width: 10px; height: 10px; border-radius: 50%; 
        background: rgba(255,255,255,0.2); cursor: pointer; transition: 0.3s; 
    }
    .dot.active { background: var(--accent); transform: scale(1.2); }

    
    /* ──────────────────── ABOUT PAGE ──────────────────── */
    .about-hero {
        text-align: center; padding: 60px 20px; margin-bottom: 40px;
        margin-top: 30px;
        position: relative;
        background: rgba(13,15,26,0.95);
        border-radius: 24px; border: 1px solid var(--border);
    }
    .bg-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=700&amp;q=80&amp;auto=format&amp;fit=crop');
        z-index: -1;
        border-radius: 24px;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }
    .dev-badge {
        background: var(--accent); color: #fff; padding: 4px 16px; 
        font-family: 'Outfit', sans-serif;
        border-radius: 50px; font-weight: 700; font-size: 0.8rem; margin-bottom: 20px; display: inline-block;
        transition: 0.3s;
    }
    .dev-badge:hover {
        transform: scale(1.05);
        cursor: pointer;
        
    }
    .profile-img {
        width: 200px;
        height: 200px;
        border-radius: 50%;
        margin: 0 auto;
        margin-bottom: 20px;
        margin-top: 20px;
        border: 1px solid var(--border);
    }
    .profile-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        transition: 0.3s;
    }
    .profile-img img:hover {
        transform: scale(1.05);
    }
    .social-links { display: flex; justify-content: center; gap: 15px; margin-top: 30px; flex-wrap: wrap; }
    .social-card {
        background: var(--surface); border: 1px solid var(--border);
        padding: 12px 24px; border-radius: 12px; transition: 0.3s;
        display: flex; align-items: center; gap: 10px; font-weight: 700;
    }
    .social-card:hover { border-color: var(--accent); background: rgba(124, 92, 252, 0.1); transform: translateY(-3px); }
    /* ──────────────────── CARDS (REFINED) ──────────────────── */
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 20px; margin-bottom: 40px; }
    .card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; transition: var(--transition); cursor: pointer; position: relative; }
    .card:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: 0 4px 10px var(--accent); }
    .card-poster { position: relative; width: 100%; aspect-ratio: 2/3; background: #0a0c14; overflow: hidden; }
    .card-poster img { width: 100%; height: 100%; object-fit: cover; transition: 0.4s ease; }
    .card:hover .card-poster img { transform: scale(1.05); }
    .card-badges { position: absolute; top: 10px; right: 10px; gap: 6px; flex-direction: column; }
    .badge { font-size: 0.65rem; font-weight: 800; padding: 3px 10px; border-radius: 6px; background: var(--accent); color: #fff; text-transform: uppercase; }
    .badge-quality {width: fit-content; background: #f1c40f; color: #111; margin-right: 3px;}
    .card-status {width: fit-content; position: absolute; bottom: 10px; left: 10px; font-size: 0.7rem; font-weight: 700; background: rgba(0,0,0,0.7); padding: 2px 8px; border-radius: 4px; }
    .card-info { padding: 15px; }
    .card-title { font-size: 0.95rem; font-weight: 700; line-height: 1.4; margin-bottom: 8px; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .card-meta { display: flex; align-items: center; justify-content: space-between; font-size: 0.75rem; color: var(--muted); }
    .card-meta span { display: flex; align-items: center; gap: 4px; }
    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 60px; }
    .info-box { background: var(--card); border: 1px solid var(--border); padding: 30px; border-radius: 18px; }
    .info-box h2 { color: var(--accent); margin-bottom: 15px; font-size: 1.3rem; }
    .info-box ul { list-style: none; }
    .info-box li { margin-bottom: 10px; display: flex; align-items: center; gap: 10px; font-size: 0.95rem; }
    
    @media (max-width: 992px) {
      .nav-links { display: none; }
      .search-bar { width: 200px; }
      .about-grid { grid-template-columns: 1fr; }
    }
    
    /* ──────────────────── MOBILE RESPONSIVE ──────────────────── */
    @media (max-width: 768px) {
      /* Navbar */
      .navbar {
        padding: 0 12px;
        height: 70px;
        gap: 0;
        justify-content: space-between;
      }
      
      .hamburger {
        display: flex;
      }
      
      .hamburger span {
        width: 18px;
        height: 2px;
      }
      
      .nav-links {
        display: none;
      }
      
      .nav-left { display: none; }
      
      /* Content */
      .container {
        padding: 0 16px 60px;
      }
      
      /* Navbar Mobile */
      .nav-right {
        display: flex;
        gap: 10px;
      }

      .mobile-actions {
        display: inline-flex;
      }
      
      .logo {
        display: block;
        font-size: 1.3rem;
      }

      .mobile-search-toggle {
        display: inline-flex;
      }

      .mobile-menu {
        top: 70px;
        width: 84%;
        max-width: 320px;
        border-radius: 0 0 0 18px;
      }

      .mobile-menu-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px 10px;
        border-bottom: 1px solid var(--border);
      }

      .mobile-menu-title {
        font-size: 1.05rem;
        font-weight: 800;
      }
      
      /* Hero Section */
      .hero {
        height: 300px;
        margin-top: 10px;
      }
      
      .slide-info {
        padding: 20px 30px 30px;
      }
      
      .slide-title {
        font-size: 1.5rem;
      }
      
      .slider-dots {
        bottom: 15px;
        left: 30px;
      }
      
      /* Search Bar */
      .search-bar {
        width: 100% !important;
        font-size: 0.85rem;
      }
      
      .search-bar input::placeholder {
        font-size: 0.8rem;
      }
      
      /* Grid Layout */
      .grid {
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 12px;
      }
      
      .card {
        border-radius: 10px;
      }
      
      .card-poster {
        aspect-ratio: 2/3;
      }
      
      .badge {
        font-size: 0.6rem;
        padding: 2px 6px;
      }
      
      /* Buttons */
      .nav-btn {
        padding: 8px 12px;
        font-size: 0.75rem;
      }
      
      /* Section Title */
      .section-title {
        font-size: 1.2rem;
      }
      
      .list-header {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
      }

      .list-header .section-title {
        margin-bottom: 0;
      }

      .dropbtn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        width: 42px;
        height: 42px;
        padding: 0;
        scale: 1;
        border-radius: 50%;
        font-size: 0.85rem;
      }
      .dropbtn i {
        margin: 0;
        font-size: 0.95rem;
      }
      .dropbtn-label {
        display: none;
      }
      
      /* About Page */
      .about-hero {
        padding: 40px 20px;
      }
      
      .profile-img {
        width: 150px;
        height: 150px;
      }
      
      .about-grid {
        grid-template-columns: 1fr;
        gap: 15px;
      }
      
      .info-box {
        padding: 20px;
      }
      
      .info-box h2 {
        font-size: 1.1rem;
      }
      
      .info-box li {
        font-size: 0.9rem;
      }
      
      .social-links {
        flex-direction: column;
        gap: 10px;
      }
      
      .social-card {
