<%- include('partials/head.ejs') %>

<style>
    /* Redesigned article layout: details-style hero + content card */
    .article-hero {
        display:flex; gap:30px; margin-top: 20px; margin-bottom: 12px;
        background: var(--card); padding: 20px; border-radius: var(--radius); border:1px solid var(--border);
        align-items: flex-start;
    }
    .article-poster { flex-shrink:0; width: 340px; max-width: 40%; border-radius: 12px; overflow: hidden; box-shadow: 0 15px 40px rgba(0,0,0,0.6); background:#0a0b12 }
    .article-poster img { width:100%; height:100%; object-fit: cover; display:block; }
    .article-info { flex:1; }
    .article-title { font-size: 2rem; font-weight: 900; margin: 6px 0 8px; color: #fff; }
    .article-meta { color: var(--muted); display:flex; gap:16px; align-items:center; font-weight:700; margin-bottom:8px; }
    .article-excerpt { color: var(--muted); margin-bottom:12px; }
    .article-body { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 26px; margin-top: 18px; color: var(--text); line-height: 1.8; }
    .video-container { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px; margin: 24px 0; border: 1px solid var(--border); }
    .video-container iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }
    .back-to-news { display: inline-flex; align-items: center; gap: 10px; color: var(--muted); font-weight: 700; margin-bottom: 18px; transition: color 0.3s; }
    .back-to-news:hover { color: var(--accent); }
    .article-actions { display:flex; gap:10px; margin-top:6px; }
    .btn-copy { background: transparent; border: 1px solid var(--border); color: var(--text); padding: 8px 12px; border-radius: 8px; font-weight: 700; cursor: pointer; }
    .btn-copy:hover { border-color: var(--accent); color: var(--accent); background: rgba(124,92,252,0.04); }
    @media (max-width: 768px) { .article-hero { flex-direction: column; } .article-poster { width:100%; max-width:100% } .article-title { font-size:1.4rem } .article-body { padding:18px } }
</style>

<div class="container" style="margin-top:18px;">
    <div class="article-hero">
        <% if (article.image) { %>
            <div class="article-poster"><img src="<%= article.image %>" alt="<%= article.title %>"></div>
        <% } %>
        <div class="article-info">
            <div class="list-header" style="margin-bottom:8px;"><h2 class="section-title" style="margin-bottom:0;"><%= article.categories || 'أخبار الأنمي' %></h2></div>
            <h1 class="article-title"><%= article.title %></h1>
            <div class="article-meta">
                <% if (article.date) { %><span><i class="fa-regular fa-calendar" style="color: var(--accent); margin-left:5px;"></i> <%= article.date %></span><% } %>
                <% if (article.author) { %><span><i class="fa-regular fa-user" style="color: var(--accent); margin-left:5px;"></i> <%= article.author %></span><% } %>
            </div>
            <div class="article-actions">
                <button id="copyArticleLink" class="btn-copy" aria-label="نسخ رابط المقال">نسخ الرابط <i class="fa-solid fa-copy"></i></button>
                <button id="shareArticleBtn" class="btn-copy" aria-label="مشاركة المقال">مشاركة <i class="fa-solid fa-share-nodes"></i></button>
            </div>
        </div>
    </div>
</div>

<main class="container">
    <article class="article-body">
        <a href="/news" class="back-to-news"><i class="fa-solid fa-arrow-right"></i> العودة للأخبار</a>
        
        <% /* main image is shown in the hero poster; no need to repeat here */ %>

        <div class="article-content">
            <%- article.content %>
        </div>

        <% if (article.iframe_url) { %>
            <div class="video-container">
                <iframe src="<%= article.iframe_url %>" frameborder="0" allowfullscreen></iframe>
            </div>
        <% } %>

        <div style="border-top: 1px solid var(--border); padding-top: 30px; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; gap: 15px;">
                <span style="color: var(--muted); font-weight: 700;">مشاركة:</span>
                <i class="fa-brands fa-facebook" style="font-size: 1.2rem; cursor: pointer; color: var(--muted);"></i>
                <i class="fa-brands fa-twitter" style="font-size: 1.2rem; cursor: pointer; color: var(--muted);"></i>
                <i class="fa-brands fa-whatsapp" style="font-size: 1.2rem; cursor: pointer; color: var(--muted);"></i>
            </div>
        </div>
    </article>
</main>

<%- include('partials/footer.ejs') %>

<script>
    // Copy current article URL
    (function(){
        const copyBtn = document.getElementById('copyArticleLink');
        if (copyBtn) copyBtn.addEventListener('click', function(){
            const btn = this; const url = window.location.href; const old = btn.innerHTML;
            navigator.clipboard && navigator.clipboard.writeText(url)
                .then(() => { btn.innerHTML = 'تم النسخ ✓'; setTimeout(()=> btn.innerHTML = old, 1600); })
                .catch(() => {
                    const ta = document.createElement('textarea'); ta.value = url; document.body.appendChild(ta); ta.select();
                    try { document.execCommand('copy'); btn.innerHTML = 'تم النسخ ✓'; } catch (e) { alert('تعذر نسخ الرابط'); }
                    ta.remove(); setTimeout(()=> btn.innerHTML = old, 1600);
                });
        });

        const shareBtn = document.getElementById('shareArticleBtn');
        if (shareBtn) shareBtn.addEventListener('click', async function(){
            const url = window.location.href;
            try {
                if (navigator.share) await navigator.share({ title: document.title, url });
                else { await navigator.clipboard.writeText(url); alert('تم نسخ الرابط للمشاركة'); }
            } catch (e) { /* ignore */ }
        });
    })();
</script>
