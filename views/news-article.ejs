<%- include('partials/head.ejs') %>

<style>
    .article-header {
        position: relative;
        height: 450px;
        padding-top: 100px;
        margin-bottom: 50px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .article-bg {
        position: absolute;
        inset: 0;
        background-image: url('<%= article.image %>');
        background-size: cover;
        background-position: center;
        filter: blur(20px) brightness(0.4);
        transform: scale(1.1);
        z-index: -1;
    }

    .article-header .container {
        position: relative;
        z-index: 2;
    }

    .article-category {
        display: inline-block;
        padding: 6px 20px;
        background: var(--accent);
        color: #fff;
        border-radius: 50px;
        font-weight: 800;
        font-size: 0.8rem;
        margin-bottom: 20px;
        box-shadow: 0 10px 20px rgba(124, 92, 252, 0.3);
    }

    .article-title {
        font-size: 3rem;
        font-weight: 900;
        line-height: 1.3;
        color: #fff;
        max-width: 900px;
        margin: 0 auto 20px;
        text-shadow: 0 5px 15px rgba(0,0,0,0.5);
    }

    .article-meta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 30px;
        color: rgba(255, 255, 255, 0.8);
        font-weight: 600;
        font-size: 0.95rem;
    }

    .article-body {
        max-width: 900px;
        margin: -80px auto 60px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 30px;
        padding: 50px;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
        position: relative;
        z-index: 10;
        backdrop-filter: blur(10px);
    }

    .article-main-img {
        width: 100%;
        border-radius: 20px;
        margin-bottom: 40px;
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
    }

    .article-content {
        font-size: 1.15rem;
        line-height: 1.8;
        color: var(--text);
        margin-bottom: 40px;
    }

    .article-content p {
        margin-bottom: 25px;
    }

    .article-content h1, .article-content h2, .article-content h3 {
        color: #fff;
        margin: 40px 0 20px;
        font-weight: 800;
    }

    .article-content a {
        color: var(--accent);
        text-decoration: underline;
    }

    /* Video Player */
    .video-container {
        position: relative;
        padding-bottom: 56.25%; /* 16:9 */
        height: 0;
        overflow: hidden;
        border-radius: 20px;
        margin: 40px 0;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
        border: 1px solid var(--border);
    }

    .video-container iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .back-to-news {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--muted);
        font-weight: 700;
        margin-bottom: 30px;
        transition: color 0.3s;
    }

    .back-to-news:hover {
        color: var(--accent);
    }

    @media (max-width: 768px) {
        .article-header { height: 350px; padding-top: 60px; }
        .article-title { font-size: 1.8rem; }
        .article-body { padding: 30px; margin-top: -50px; border-radius: 20px; }
        .article-content { font-size: 1.05rem; }
        .article-meta { gap: 15px; font-size: 0.8rem; }
    }
</style>

<div class="article-header">
    <div class="article-bg"></div>
    <div class="container">
        <span class="article-category"><%= article.categories || 'أخبار الأنمي' %></span>
        <h1 class="article-title"><%= article.title %></h1>
        <div class="article-meta">
            <% if (article.date) { %>
                <span><i class="fa-regular fa-calendar" style="color: var(--accent); margin-left: 5px;"></i> <%= article.date %></span>
            <% } %>
            <% if (article.author) { %>
                <span><i class="fa-regular fa-user" style="color: var(--accent); margin-left: 5px;"></i> <%= article.author %></span>
            <% } %>
        </div>
    </div>
</div>

<main class="container">
    <article class="article-body">
        <a href="/news" class="back-to-news"><i class="fa-solid fa-arrow-right"></i> العودة للأخبار</a>
        
        <% if (article.image) { %>
            <img src="<%= article.image %>" alt="<%= article.title %>" class="article-main-img" />
        <% } %>

        <div class="article-content">
            <%- article.content %>
        </div>

        <% if (article.iframe_url) { %>
            <div class="video-container">
                <iframe src="<%= article.iframe_url %>" frameborder="0" allowfullscreen></iframe>
            </div>
        <% } %>

        <div style="border-top: 1px solid var(--border); padding-top: 30px; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; gap: 15px;">
                <span style="color: var(--muted); font-weight: 700;">مشاركة:</span>
                <i class="fa-brands fa-facebook" style="font-size: 1.2rem; cursor: pointer; color: var(--muted);"></i>
                <i class="fa-brands fa-twitter" style="font-size: 1.2rem; cursor: pointer; color: var(--muted);"></i>
                <i class="fa-brands fa-whatsapp" style="font-size: 1.2rem; cursor: pointer; color: var(--muted);"></i>
            </div>
        </div>
    </article>
</main>

<%- include('partials/footer.ejs') %>
