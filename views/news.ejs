<%- include('partials/head.ejs') %>

<style>
    .nexo-news-empty { text-align: center; padding: 100px 20px; background: var(--surface); border-radius: 20px; border: 1px dashed var(--border); }
    @media (max-width: 768px) { .nexo-news-empty { padding: 60px 14px; } }
</style>

<div class="list-header" style="margin-top:20px; margin-bottom:18px;">
    <h2 class="section-title" style="margin-bottom:0;"><%= title || 'أخبار الأنمي' %></h2>
</div>

<main class="container">
    <% if (newsList && newsList.length > 0) { %>
        <div class="nexo-news-grid">
            <% newsList.forEach(news => { %>
                <div class="nexo-news-card" onclick="window.location.href='/news-article?url=<%= encodeURIComponent(news.url) %>&server=<%= currentServer %>'">
                    <div class="nexo-news-thumb">
                        <img src="<%= news.image || 'https://via.placeholder.com/800x450?text=News' %>" alt="<%= news.title %>" loading="lazy" />
                    </div>
                    <div class="nexo-news-content">
                        <div class="nexo-news-meta">
                            <% if (news.date) { %>
                                <span><i class="fa-regular fa-calendar"></i> <%= news.date %></span>
                            <% } %>
                            <span><i class="fa-regular fa-bookmark"></i> خبر</span>
                        </div>
                        <h2 class="nexo-news-title"><%= news.title %></h2>
                        <div class="nexo-news-footer">
                            <button class="nexo-news-cta" type="button" data-url="/news-article?url=<%= encodeURIComponent(news.url) %>&server=<%= currentServer %>" aria-label="نسخ الرابط">نسخ الرابط <i class="fa-solid fa-copy"></i></button>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="nexo-news-empty">
            <i class="fa-solid fa-newspaper" style="font-size: 3rem; color: var(--muted); margin-bottom: 20px;"></i>
            <p>لا توجد أخبار متاحة حالياً. يرجى المحاولة لاحقاً!</p>
        </div>
    <% } %>
</main>

<%- include('partials/footer.ejs') %>

<script>
        // Copy link buttons for news grid (copy absolute URL)
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.nexo-news-cta');
            if (!btn) return;
            let url = btn.getAttribute('data-url');
            if (!url) return;
            // If it's a relative internal path, make absolute
            if (!url.startsWith('http')) {
                url = window.location.origin + url;
            }
            const doCopy = (text) => navigator.clipboard && navigator.clipboard.writeText(text)
                .then(() => true).catch(() => false);

            doCopy(url).then(success => {
                const old = btn.innerHTML;
                btn.innerHTML = 'تم النسخ ✓';
                setTimeout(() => btn.innerHTML = old, 1600);
                if (!success) {
                    // fallback
                    const ta = document.createElement('textarea'); ta.value = url; document.body.appendChild(ta); ta.select();
                    try { document.execCommand('copy'); }
                    catch (err) { alert('تعذر نسخ الرابط'); }
                    ta.remove();
                }
            });
        });
</script>
