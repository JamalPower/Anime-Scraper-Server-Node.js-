{
  "version": 2,
  "builds": [
    {
      "src": "api/app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "views/**",
          "DataStandardizer.js",
          "HomeContent_1.js",
          "HomeContent_2.js",
          "HomeContent_3.js",
          "scraperAxios.js"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/app.js"
    }
  ]
}